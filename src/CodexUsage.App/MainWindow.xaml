<Window
    x:Class="CodexUsage.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CodexUsage.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="WindowRoot" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CommandHeaderGrid.Padding" Value="20,16" />
                        <Setter Target="CommandTitle.FontSize" Value="20" />
                        <Setter Target="WideCommandBar.Visibility" Value="Collapsed" />
                        <Setter Target="CompactCommandBar.Visibility" Value="Visible" />
                        <Setter Target="BodyRoot.Margin" Value="20,0" />
                        <Setter Target="BodyStack.Spacing" Value="16" />
                        <Setter Target="WideMetrics.Visibility" Value="Collapsed" />
                        <Setter Target="CompactMetrics.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CommandHeaderGrid.Padding" Value="24,16" />
                        <Setter Target="CommandTitle.FontSize" Value="21" />
                        <Setter Target="WideCommandBar.Visibility" Value="Collapsed" />
                        <Setter Target="CompactCommandBar.Visibility" Value="Visible" />
                        <Setter Target="BodyRoot.Margin" Value="24,0" />
                        <Setter Target="BodyStack.Spacing" Value="18" />
                        <Setter Target="WideMetrics.Visibility" Value="Visible" />
                        <Setter Target="CompactMetrics.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CommandHeaderGrid.Padding" Value="28,14" />
                        <Setter Target="CommandTitle.FontSize" Value="22" />
                        <Setter Target="WideCommandBar.Visibility" Value="Visible" />
                        <Setter Target="CompactCommandBar.Visibility" Value="Collapsed" />
                        <Setter Target="BodyRoot.Margin" Value="28,0" />
                        <Setter Target="BodyStack.Spacing" Value="20" />
                        <Setter Target="WideMetrics.Visibility" Value="Visible" />
                        <Setter Target="CompactMetrics.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="TableLayoutStates">
                <VisualState x:Name="StackedTables">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TableFirstColumn.Width" Value="*" />
                        <Setter Target="TableSecondColumn.Width" Value="0" />
                        <Setter Target="RoleTable.(Grid.Row)" Value="1" />
                        <Setter Target="RoleTable.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SideBySideTables">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1440" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TableFirstColumn.Width" Value="*" />
                        <Setter Target="TableSecondColumn.Width" Value="*" />
                        <Setter Target="RoleTable.(Grid.Row)" Value="0" />
                        <Setter Target="RoleTable.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="13,0"
            Background="{StaticResource TitleBarBrush}"
            ColumnDefinitions="Auto,*">
            <Border
                Width="16"
                Height="16"
                VerticalAlignment="Center"
                Background="{StaticResource PrimaryFillBrush}"
                CornerRadius="3" />
            <TextBlock
                x:Name="TitleBarText"
                Grid.Column="1"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="Medium"
                Foreground="{StaticResource SecondaryTextBrush}"
                Text="Codex Usage Desktop" />
        </Grid>

        <Border
            Grid.Row="1"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource TableDividerBrush}"
            BorderThickness="0,0,0,1">
            <Grid
                x:Name="CommandHeaderGrid"
                Padding="28,14"
                ColumnDefinitions="Auto,*,Auto"
                RowDefinitions="Auto,Auto"
                RowSpacing="10">
                <TextBlock
                    x:Name="CommandTitle"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    Text="Codex 用量概览" />

                <Grid
                    Grid.Column="1"
                    MaxWidth="300"
                    Margin="24,0,16,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding HeaderStatusText}"
                    ColumnDefinitions="Auto,*"
                    ToolTipService.ToolTip="{Binding HeaderStatusText}">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{Binding HeaderStatusBrush}"
                        Glyph="{Binding HeaderStatusGlyph}" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="7,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="{Binding HeaderStatusText}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>

                <CommandBar
                    x:Name="WideCommandBar"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    IsDynamicOverflowEnabled="True"
                    Padding="0">
                    <CommandBar.Content>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <ProgressRing Width="16" Height="16" IsActive="{Binding IsSyncing}" />
                            <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Text="开机自启动" />
                            <ToggleSwitch
                                VerticalAlignment="Center"
                                IsEnabled="{Binding IsStartupAvailable}"
                                IsOn="{Binding IsStartupEnabled, Mode=TwoWay}"
                                OffContent="关"
                                OnContent="开" />
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6"
                                Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ProgressBar
                                    Width="104"
                                    Height="4"
                                    VerticalAlignment="Center"
                                    IsIndeterminate="{Binding IsUpdateDownloadIndeterminate}"
                                    Maximum="100"
                                    Value="{Binding UpdateDownloadProgressPercent}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="{Binding UpdateDownloadProgressText}" />
                            </StackPanel>
                        </StackPanel>
                    </CommandBar.Content>
                    <AppBarButton Height="40" Click="OnCheckUpdateRequested" Icon="Refresh" IsEnabled="{Binding CanCheckUpdates}" Label="检查更新（未签名实验）" />
                    <AppBarButton Height="40" Click="OnDownloadUpdateRequested" Icon="Download" IsEnabled="{Binding CanDownloadUpdate}" Label="{Binding DownloadUpdateLabel}" Visibility="{Binding CanDownloadUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <AppBarButton Height="40" Click="OnRunUpdateRequested" Icon="OpenFile" IsEnabled="{Binding CanRunDownloadedUpdate}" Label="{Binding RunUpdateLabel}" ToolTipService.ToolTip="未签名安装器会先复验 SHA-256; 确认后 NSIS 会结束当前应用和 collector process" Visibility="{Binding CanRunDownloadedUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <AppBarButton Height="40" Click="OnSyncRequested" Icon="Sync" IsEnabled="{Binding CanSync}" Label="立即同步" />
                    <AppBarButton Height="40" Click="OnExportRequested" Icon="Download" Label="导出 CSV" />
                </CommandBar>

                <CommandBar
                    x:Name="CompactCommandBar"
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    IsDynamicOverflowEnabled="True"
                    Padding="0"
                    Visibility="Collapsed">
                    <CommandBar.Content>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <ProgressRing Width="16" Height="16" IsActive="{Binding IsSyncing}" />
                            <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Text="开机自启动" />
                            <ToggleSwitch
                                VerticalAlignment="Center"
                                IsEnabled="{Binding IsStartupAvailable}"
                                IsOn="{Binding IsStartupEnabled, Mode=TwoWay}"
                                OffContent="关"
                                OnContent="开" />
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6"
                                Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ProgressBar
                                    Width="104"
                                    Height="4"
                                    VerticalAlignment="Center"
                                    IsIndeterminate="{Binding IsUpdateDownloadIndeterminate}"
                                    Maximum="100"
                                    Value="{Binding UpdateDownloadProgressPercent}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="{Binding UpdateDownloadProgressText}" />
                            </StackPanel>
                        </StackPanel>
                    </CommandBar.Content>
                    <AppBarButton Height="40" Click="OnCheckUpdateRequested" Icon="Refresh" IsEnabled="{Binding CanCheckUpdates}" Label="检查更新（未签名实验）" />
                    <AppBarButton Height="40" Click="OnDownloadUpdateRequested" Icon="Download" IsEnabled="{Binding CanDownloadUpdate}" Label="{Binding DownloadUpdateLabel}" Visibility="{Binding CanDownloadUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <AppBarButton Height="40" Click="OnRunUpdateRequested" Icon="OpenFile" IsEnabled="{Binding CanRunDownloadedUpdate}" Label="{Binding RunUpdateLabel}" ToolTipService.ToolTip="未签名安装器会先复验 SHA-256; 确认后 NSIS 会结束当前应用和 collector process" Visibility="{Binding CanRunDownloadedUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <AppBarButton Height="40" Click="OnSyncRequested" Icon="Sync" IsEnabled="{Binding CanSync}" Label="立即同步" />
                    <AppBarButton Height="40" Click="OnExportRequested" Icon="Download" Label="导出 CSV" />
                </CommandBar>
            </Grid>
        </Border>

        <ScrollViewer
            x:Name="BodyRoot"
            Grid.Row="2"
            Margin="28,0"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto"
            ViewChanged="OnBodyRootViewChanged">
            <StackPanel x:Name="BodyStack" Padding="0,8,16,28" Spacing="20">
                <Border
                    BorderBrush="{StaticResource TableDividerBrush}"
                    BorderThickness="0,0,0,1">
                    <controls:AuditFilterContent />
                </Border>

                <Border
                    Padding="14,10"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource TableDividerBrush}"
                    BorderThickness="0,1">
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource PrimaryBrush}"
                            Glyph="&#xE8D4;" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Text="语音会话" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource SecondaryTextBrush}">
                            <Run Text="{Binding RealtimeVoiceSessionsText}" />
                            <Run Text=" · 无 token 明细 / 未计费" />
                        </TextBlock>
                    </Grid>
                </Border>

                <Border
                    x:Name="WideMetrics"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource TableDividerBrush}"
                    BorderThickness="0,1">
                    <Grid ColumnDefinitions="*,1,*,1,*,1,*,1,*">
                        <StackPanel Grid.Column="0" Margin="14,10" Spacing="2">
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[0].Label}" />
                            <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics[0].Value}" />
                        </StackPanel>
                        <Rectangle Grid.Column="1" Margin="0,10" Fill="{StaticResource TableDividerBrush}" />
                        <StackPanel Grid.Column="2" Margin="14,10" Spacing="2">
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[1].Label}" />
                            <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics[1].Value}" />
                        </StackPanel>
                        <Rectangle Grid.Column="3" Margin="0,10" Fill="{StaticResource TableDividerBrush}" />
                        <StackPanel Grid.Column="4" Margin="14,10" Spacing="2">
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[2].Label}" />
                            <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics[2].Value}" />
                        </StackPanel>
                        <Rectangle Grid.Column="5" Margin="0,10" Fill="{StaticResource TableDividerBrush}" />
                        <StackPanel Grid.Column="6" Margin="14,10" Spacing="2">
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[3].Label}" />
                            <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics[3].Value}" />
                        </StackPanel>
                        <Rectangle Grid.Column="7" Margin="0,10" Fill="{StaticResource TableDividerBrush}" />
                        <StackPanel Grid.Column="8" Margin="14,10" Spacing="2">
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[4].Label}" />
                            <TextBlock FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding Metrics[4].Value}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    x:Name="CompactMetrics"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource TableDividerBrush}"
                    BorderThickness="0,1"
                    Visibility="Collapsed">
                    <Grid RowDefinitions="Auto,1,Auto,1,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*,1,*">
                            <StackPanel Grid.Column="0" Margin="14,10" Spacing="2">
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[0].Label}" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics[0].Value}" />
                            </StackPanel>
                            <Rectangle Grid.Column="1" Margin="0,10" Fill="{StaticResource TableDividerBrush}" />
                            <StackPanel Grid.Column="2" Margin="14,10" Spacing="2">
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[1].Label}" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics[1].Value}" />
                            </StackPanel>
                        </Grid>
                        <Rectangle Grid.Row="1" Fill="{StaticResource TableDividerBrush}" />
                        <Grid Grid.Row="2" ColumnDefinitions="*,1,*">
                            <StackPanel Grid.Column="0" Margin="14,10" Spacing="2">
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[2].Label}" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics[2].Value}" />
                            </StackPanel>
                            <Rectangle Grid.Column="1" Margin="0,10" Fill="{StaticResource TableDividerBrush}" />
                            <StackPanel Grid.Column="2" Margin="14,10" Spacing="2">
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[3].Label}" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics[3].Value}" />
                            </StackPanel>
                        </Grid>
                        <Rectangle Grid.Row="3" Fill="{StaticResource TableDividerBrush}" />
                        <StackPanel Grid.Row="4" Margin="14,10" Spacing="2">
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[4].Label}" />
                            <TextBlock FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding Metrics[4].Value}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    Padding="14,12"
                    BorderBrush="{StaticResource TableDividerBrush}"
                    BorderThickness="0,1">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="费用构成" />
                        <controls:CostCompositionBar
                            Height="10"
                            Background="{StaticResource ProgressTrackBrush}"
                            Items="{Binding CostSlices}" />
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                            <Grid Column="0" MinWidth="0" ColumnDefinitions="12,*" ColumnSpacing="10">
                                <Rectangle Width="12" Height="12" VerticalAlignment="Center" Fill="{StaticResource CostUncachedBrush}" />
                                <TextBlock Grid.Column="1" FontSize="14" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="WrapWholeWords">
                                    <Run Text="无缓存输入 " />
                                    <Run Text="{Binding CostSlices[0].Detail}" />
                                </TextBlock>
                            </Grid>
                            <Grid Grid.Column="1" MinWidth="0" ColumnDefinitions="12,*" ColumnSpacing="10">
                                <Rectangle Width="12" Height="12" VerticalAlignment="Center" Fill="{StaticResource CostCachedBrush}" />
                                <TextBlock Grid.Column="1" FontSize="14" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="WrapWholeWords">
                                    <Run Text="缓存输入 " />
                                    <Run Text="{Binding CostSlices[1].Detail}" />
                                </TextBlock>
                            </Grid>
                            <Grid Grid.Column="2" MinWidth="0" ColumnDefinitions="12,*" ColumnSpacing="10">
                                <Rectangle Width="12" Height="12" VerticalAlignment="Center" Fill="{StaticResource CostReasoningBrush}" />
                                <TextBlock Grid.Column="1" FontSize="14" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="WrapWholeWords">
                                    <Run Text="思考输出 " />
                                    <Run Text="{Binding CostSlices[2].Detail}" />
                                </TextBlock>
                            </Grid>
                            <Grid Grid.Column="3" MinWidth="0" ColumnDefinitions="12,*" ColumnSpacing="10">
                                <Rectangle Width="12" Height="12" VerticalAlignment="Center" Fill="{StaticResource CostOtherBrush}" />
                                <TextBlock Grid.Column="1" FontSize="14" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="WrapWholeWords">
                                    <Run Text="其他输出 " />
                                    <Run Text="{Binding CostSlices[3].Detail}" />
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid x:Name="TableGrid" ColumnSpacing="12" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="TableFirstColumn" Width="*" />
                        <ColumnDefinition x:Name="TableSecondColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="ModelTable"
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="0,10,0,0"
                        BorderBrush="{StaticResource TableDividerBrush}"
                        BorderThickness="0,1"
                        SizeChanged="OnStickyTableSizeChanged">
                        <StackPanel Spacing="10">
                            <TextBlock Margin="12,0" Style="{StaticResource SectionTitleStyle}" Text="按模型" />
                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto">
                                <Grid
                                    x:Name="ModelTableHeader"
                                    Grid.Row="0"
                                    Grid.ColumnSpan="2"
                                    Background="{StaticResource TableHeaderBrush}"
                                    Canvas.ZIndex="10">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="ModelTableHeaderTransform" />
                                    </Grid.RenderTransform>
                                    <Grid ColumnDefinitions="200,*">
                                        <Border
                                            Grid.Column="0"
                                            Background="{StaticResource TableHeaderBrush}"
                                            BorderBrush="{StaticResource TableDividerBrush}"
                                            BorderThickness="0,1,1,1">
                                            <TextBlock
                                                Padding="12,7"
                                                AutomationProperties.Name="模型"
                                                Foreground="{StaticResource PrimaryTextBrush}"
                                                Loaded="OnTableCellLoaded"
                                                Style="{StaticResource TableHeaderTextStyle}"
                                                Text="模型"
                                                TextWrapping="Wrap" />
                                        </Border>
                                        <ScrollViewer
                                            x:Name="ModelHeaderScroll"
                                            Grid.Column="1"
                                            HorizontalScrollBarVisibility="Hidden"
                                            HorizontalScrollMode="Enabled"
                                            IsHitTestVisible="False"
                                            VerticalScrollBarVisibility="Disabled"
                                            VerticalScrollMode="Disabled">
                                            <Border Background="{StaticResource TableHeaderBrush}" BorderBrush="{StaticResource TableDividerBrush}" BorderThickness="0,1">
                                                <Grid MinWidth="740" Padding="12,7" ColumnDefinitions=".85*,.95*,.95*,.7*,.85*,.65*,.65*" Loaded="OnTableCellLoaded">
                                                    <TextBlock Style="{StaticResource TableHeaderTextStyle}" Text="总 tokens" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderTextStyle}" Text="无缓存输入" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderTextStyle}" Text="缓存输入" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderTextStyle}" Text="输出" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="4" Style="{StaticResource TableHeaderTextStyle}" Text="思考输出" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="5" Style="{StaticResource TableHeaderTextStyle}" Text="费用" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="6" Style="{StaticResource TableHeaderTextStyle}" Text="价格占比" TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                                <ItemsControl
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    HorizontalContentAlignment="Stretch"
                                    ItemsSource="{Binding Models}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource TableDividerBrush}" BorderThickness="0,0,1,1">
                                                <TextBlock
                                                    Padding="12,7"
                                                    AutomationProperties.Name="{Binding Model}"
                                                    FontWeight="SemiBold"
                                                    Loaded="OnTableCellLoaded"
                                                    Style="{StaticResource TableCellTextStyle}"
                                                    Text="{Binding Model}"
                                                    TextWrapping="Wrap"
                                                    ToolTipService.ToolTip="{Binding Model}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ScrollViewer
                                    x:Name="ModelValuesScroll"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    HorizontalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Enabled"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalScrollBarVisibility="Disabled"
                                    VerticalScrollMode="Disabled"
                                    ViewChanged="OnModelValuesViewChanged">
                                    <ItemsControl MinWidth="740" HorizontalContentAlignment="Stretch" ItemsSource="{Binding Models}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource TableDividerBrush}" BorderThickness="0,0,0,1">
                                                    <Grid Padding="12,7" ColumnDefinitions=".85*,.95*,.95*,.7*,.85*,.65*,.65*" Loaded="OnTableCellLoaded">
                                                        <TextBlock Style="{StaticResource TableCellTextStyle}" Text="{Binding TotalTokens}" />
                                                        <TextBlock Grid.Column="1" Style="{StaticResource TableCellTextStyle}" Text="{Binding UncachedInput}" />
                                                        <TextBlock Grid.Column="2" Style="{StaticResource TableCellTextStyle}" Text="{Binding CachedInput}" />
                                                        <TextBlock Grid.Column="3" Style="{StaticResource TableCellTextStyle}" Text="{Binding Output}" />
                                                        <TextBlock Grid.Column="4" Style="{StaticResource TableCellTextStyle}" Text="{Binding ReasoningOutput}" />
                                                        <TextBlock Grid.Column="5" Style="{StaticResource PriceCellTextStyle}" Text="{Binding Cost}" />
                                                        <TextBlock Grid.Column="6" Style="{StaticResource TableCellTextStyle}" Text="{Binding Share}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="12,9" Style="{StaticResource CaptionStyle}">
                                    <Run Text="共 " />
                                    <Run Text="{Binding Models.Count}" />
                                    <Run Text=" 条" />
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="RoleTable"
                        Grid.Row="1"
                        Grid.Column="0"
                        Padding="0,10,0,0"
                        BorderBrush="{StaticResource TableDividerBrush}"
                        BorderThickness="0,1"
                        SizeChanged="OnStickyTableSizeChanged">
                        <StackPanel Spacing="10">
                            <TextBlock Margin="12,0" Style="{StaticResource SectionTitleStyle}" Text="按线程类型和角色" />
                            <Grid ColumnDefinitions="280,*" RowDefinitions="Auto,Auto,Auto">
                                <Grid
                                    x:Name="RoleTableHeader"
                                    Grid.Row="0"
                                    Grid.ColumnSpan="2"
                                    Background="{StaticResource TableHeaderBrush}"
                                    Canvas.ZIndex="10">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="RoleTableHeaderTransform" />
                                    </Grid.RenderTransform>
                                    <Grid ColumnDefinitions="280,*">
                                        <Border
                                            Grid.Column="0"
                                            Background="{StaticResource TableHeaderBrush}"
                                            BorderBrush="{StaticResource TableDividerBrush}"
                                            BorderThickness="0,1,1,1">
                                            <Grid Padding="12,7" ColumnDefinitions=".8*,1.2*" Loaded="OnTableCellLoaded">
                                                <TextBlock Foreground="{StaticResource PrimaryTextBrush}" Style="{StaticResource TableHeaderTextStyle}" Text="线程类型" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Foreground="{StaticResource PrimaryTextBrush}" Style="{StaticResource TableHeaderTextStyle}" Text="具体角色" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                        <ScrollViewer
                                            x:Name="RoleHeaderScroll"
                                            Grid.Column="1"
                                            HorizontalScrollBarVisibility="Hidden"
                                            HorizontalScrollMode="Enabled"
                                            IsHitTestVisible="False"
                                            VerticalScrollBarVisibility="Disabled"
                                            VerticalScrollMode="Disabled">
                                            <Border Background="{StaticResource TableHeaderBrush}" BorderBrush="{StaticResource TableDividerBrush}" BorderThickness="0,1">
                                                <Grid MinWidth="800" Padding="12,7" ColumnDefinitions=".85*,.95*,.95*,.7*,.85*,.65*,.65*" Loaded="OnTableCellLoaded">
                                                    <TextBlock Style="{StaticResource TableHeaderTextStyle}" Text="总 tokens" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderTextStyle}" Text="无缓存输入" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderTextStyle}" Text="缓存输入" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderTextStyle}" Text="输出" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="4" Style="{StaticResource TableHeaderTextStyle}" Text="思考输出" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="5" Style="{StaticResource TableHeaderTextStyle}" Text="费用" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="6" Style="{StaticResource TableHeaderTextStyle}" Text="价格占比" TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                                <ItemsControl
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    HorizontalContentAlignment="Stretch"
                                    ItemsSource="{Binding Subjects}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource TableDividerBrush}" BorderThickness="0,0,1,1">
                                                <Grid Padding="12,7" ColumnDefinitions=".8*,1.2*" Loaded="OnTableCellLoaded">
                                                    <TextBlock
                                                        AutomationProperties.Name="{Binding ThreadType}"
                                                        FontWeight="SemiBold"
                                                        Style="{StaticResource TableCellTextStyle}"
                                                        Text="{Binding ThreadType}"
                                                        TextWrapping="Wrap"
                                                        ToolTipService.ToolTip="{Binding ThreadType}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        AutomationProperties.Name="{Binding Role}"
                                                        FontWeight="SemiBold"
                                                        Style="{StaticResource TableCellTextStyle}"
                                                        Text="{Binding Role}"
                                                        TextWrapping="Wrap"
                                                        ToolTipService.ToolTip="{Binding Role}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ScrollViewer
                                    x:Name="RoleValuesScroll"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    HorizontalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Enabled"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalScrollBarVisibility="Disabled"
                                    VerticalScrollMode="Disabled"
                                    ViewChanged="OnRoleValuesViewChanged">
                                    <ItemsControl MinWidth="800" HorizontalContentAlignment="Stretch" ItemsSource="{Binding Subjects}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource TableDividerBrush}" BorderThickness="0,0,0,1">
                                                    <Grid Padding="12,7" ColumnDefinitions=".85*,.95*,.95*,.7*,.85*,.65*,.65*" Loaded="OnTableCellLoaded">
                                                        <TextBlock Style="{StaticResource TableCellTextStyle}" Text="{Binding TotalTokens}" />
                                                        <TextBlock Grid.Column="1" Style="{StaticResource TableCellTextStyle}" Text="{Binding UncachedInput}" />
                                                        <TextBlock Grid.Column="2" Style="{StaticResource TableCellTextStyle}" Text="{Binding CachedInput}" />
                                                        <TextBlock Grid.Column="3" Style="{StaticResource TableCellTextStyle}" Text="{Binding Output}" />
                                                        <TextBlock Grid.Column="4" Style="{StaticResource TableCellTextStyle}" Text="{Binding ReasoningOutput}" />
                                                        <TextBlock Grid.Column="5" Style="{StaticResource PriceCellTextStyle}" Text="{Binding Cost}" />
                                                        <TextBlock Grid.Column="6" Style="{StaticResource TableCellTextStyle}" Text="{Binding Share}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="12,9" Style="{StaticResource CaptionStyle}">
                                    <Run Text="共 " />
                                    <Run Text="{Binding Subjects.Count}" />
                                    <Run Text=" 条" />
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource TableDividerBrush}"
                    BorderThickness="0,1">
                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="12,4"
                        AutomationProperties.Name="诊断详情"
                        Header="诊断"
                        IsExpanded="False">
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Auto"
                            HorizontalContentAlignment="Stretch"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled">
                            <ListView
                                MinWidth="620"
                                Padding="0,8,0,0"
                                HorizontalContentAlignment="Stretch"
                                ItemsSource="{Binding Diagnostics}"
                                SelectionMode="None"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.HorizontalScrollMode="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollMode="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="42" Padding="10,7" ColumnDefinitions="180,140,*">
                                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Label}" />
                                            <TextBlock Grid.Column="1" FontSize="14" Text="{Binding Value}" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource CaptionStyle}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ScrollViewer>
                    </Expander>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
