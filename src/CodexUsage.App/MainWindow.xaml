<Window
    x:Class="CodexUsage.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CodexUsage.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="WindowRoot" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition x:Name="CommandRow" Height="68" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CommandRow.Height" Value="52" />
                        <Setter Target="CommandTitle.Text" Value="用量概览" />
                        <Setter Target="CommandTitle.FontSize" Value="18" />
                        <Setter Target="CommandSubtitle.Text" Value="实时本机审计" />
                        <Setter Target="WideCommandBar.Visibility" Value="Collapsed" />
                        <Setter Target="CompactCommandBar.Visibility" Value="Visible" />
                        <Setter Target="BodyRoot.Margin" Value="12" />
                        <Setter Target="FilterPane.Visibility" Value="Collapsed" />
                        <Setter Target="FilterColumn.Width" Value="0" />
                        <Setter Target="FilterGap.Width" Value="0" />
                        <Setter Target="CompactFilter.Visibility" Value="Visible" />
                        <Setter Target="WideMetrics.Visibility" Value="Collapsed" />
                        <Setter Target="CompactMetrics.Visibility" Value="Visible" />
                        <Setter Target="WideCostRows.Visibility" Value="Collapsed" />
                        <Setter Target="CompactCostRows.Visibility" Value="Visible" />
                        <Setter Target="RunSummaryCard.Visibility" Value="Collapsed" />
                        <Setter Target="CostColumn.Width" Value="*" />
                        <Setter Target="DetailGap.Width" Value="0" />
                        <Setter Target="RunColumn.Width" Value="0" />
                        <Setter Target="ModelOverviewCard.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="960" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CommandRow.Height" Value="68" />
                        <Setter Target="CommandTitle.Text" Value="Codex 用量概览" />
                        <Setter Target="CommandTitle.FontSize" Value="20" />
                        <Setter Target="CommandSubtitle.Text" Value="本机 Codex 审计 · 标准 API 费用估算" />
                        <Setter Target="WideCommandBar.Visibility" Value="Visible" />
                        <Setter Target="CompactCommandBar.Visibility" Value="Collapsed" />
                        <Setter Target="BodyRoot.Margin" Value="22" />
                        <Setter Target="FilterPane.Visibility" Value="Visible" />
                        <Setter Target="FilterColumn.Width" Value="284" />
                        <Setter Target="FilterGap.Width" Value="18" />
                        <Setter Target="CompactFilter.Visibility" Value="Collapsed" />
                        <Setter Target="WideMetrics.Visibility" Value="Visible" />
                        <Setter Target="CompactMetrics.Visibility" Value="Collapsed" />
                        <Setter Target="WideCostRows.Visibility" Value="Visible" />
                        <Setter Target="CompactCostRows.Visibility" Value="Collapsed" />
                        <Setter Target="RunSummaryCard.Visibility" Value="Visible" />
                        <Setter Target="CostColumn.Width" Value="*" />
                        <Setter Target="DetailGap.Width" Value="14" />
                        <Setter Target="RunColumn.Width" Value="*" />
                        <Setter Target="ModelOverviewCard.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Background="{StaticResource TitleBarBrush}"
            ColumnDefinitions="Auto,*"
            Padding="14,0">
            <Border
                Width="18"
                Height="18"
                VerticalAlignment="Center"
                Background="{StaticResource PrimaryFillBrush}"
                CornerRadius="9" />
            <TextBlock
                Grid.Column="1"
                Margin="9,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="Medium"
                Foreground="{StaticResource PrimaryTextBrush}"
                Text="Codex Usage Desktop" />
        </Grid>

        <Border
            Grid.Row="1"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid Padding="24,0" ColumnDefinitions="Auto,*">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="CommandTitle"
                        Style="{StaticResource SectionTitleStyle}"
                        Text="Codex 用量概览" />
                    <TextBlock
                        x:Name="CommandSubtitle"
                        Style="{StaticResource CaptionStyle}"
                        Text="本机 Codex 审计 · 标准 API 费用估算" />
                </StackPanel>

                <CommandBar
                    x:Name="WideCommandBar"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    IsOpen="False">
                    <CommandBar.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing
                                Width="18"
                                Height="18"
                                IsActive="{Binding IsSyncing}" />
                            <ToggleSwitch
                                Margin="8,0"
                                Header="开机自启动"
                                IsEnabled="{Binding IsStartupAvailable}"
                                IsOn="{Binding IsStartupEnabled, Mode=TwoWay}"
                                OffContent="关"
                                OnContent="开" />
                        </StackPanel>
                    </CommandBar.Content>
                    <AppBarButton Click="OnCheckUpdateRequested" Icon="Refresh" IsEnabled="{Binding CanCheckUpdates}" Label="检查更新" />
                    <AppBarButton Click="OnSyncRequested" Icon="Sync" IsEnabled="{Binding CanSync}" Label="立即同步" />
                    <AppBarButton Click="OnExportRequested" Icon="Download" Label="导出 CSV" />
                </CommandBar>

                <CommandBar
                    x:Name="CompactCommandBar"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    Visibility="Collapsed">
                    <CommandBar.Content>
                        <ProgressRing Width="18" Height="18" IsActive="{Binding IsSyncing}" />
                    </CommandBar.Content>
                    <AppBarButton Click="OnSyncRequested" Icon="Sync" IsEnabled="{Binding CanSync}" Label="立即同步" />
                    <CommandBar.SecondaryCommands>
                        <AppBarButton Click="OnCheckUpdateRequested" Icon="Refresh" IsEnabled="{Binding CanCheckUpdates}" Label="检查更新" />
                        <AppBarToggleButton Icon="Play" IsChecked="{Binding IsStartupEnabled, Mode=TwoWay}" IsEnabled="{Binding IsStartupAvailable}" Label="开机自启动" />
                        <AppBarButton Click="OnExportRequested" Icon="Download" Label="导出 CSV" />
                    </CommandBar.SecondaryCommands>
                </CommandBar>
            </Grid>
        </Border>

        <Grid x:Name="BodyRoot" Grid.Row="2" Margin="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FilterColumn" Width="284" />
                <ColumnDefinition x:Name="FilterGap" Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="FilterPane"
                Grid.Column="0"
                Style="{StaticResource CardStyle}"
                Padding="16">
                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="3">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="审计筛选" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="筛选变化后自动刷新" />
                        </StackPanel>
                        <Border
                            HorizontalAlignment="Left"
                            Padding="9,5"
                            Background="#1A72D8B8"
                            BorderBrush="#5972D8B8"
                            BorderThickness="1"
                            CornerRadius="999">
                            <TextBlock FontSize="10" Foreground="{StaticResource SuccessBrush}" Text="●  实时筛选" />
                        </Border>
                        <controls:AuditFilterContent />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="2" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                        <Expander
                            x:Name="CompactFilter"
                            Grid.Row="0"
                            Header="审计筛选"
                            IsExpanded="False"
                            Visibility="Collapsed">
                            <StackPanel Padding="0,10,0,4" Spacing="8">
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding RangeLabel}" />
                                <controls:AuditFilterContent />
                            </StackPanel>
                        </Expander>

                        <InfoBar
                            x:Name="ConflictInfoBar"
                            Grid.Row="1"
                            IsClosable="False"
                            IsOpen="{Binding HasConflicts}"
                            Message="{Binding ConflictMessage}"
                            Severity="Error"
                            Title="{Binding ConflictTitle}">
                        </InfoBar>

                        <Border Grid.Row="2" Style="{StaticResource InsetCardStyle}" Padding="10,7">
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="2">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Text="●" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionStyle}"
                                    Text="{Binding CollectorStatusText}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionStyle}"
                                    Text="{Binding LastReconciliationText}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Style="{StaticResource CaptionStyle}"
                                    Text="{Binding PlatformStatusText}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>

                        <TabView
                            Grid.Row="3"
                            IsAddTabButtonVisible="False"
                            TabWidthMode="SizeToContent">
                            <TabViewItem Header="概览" IsClosable="False">
                                <ScrollViewer
                                    HorizontalScrollBarVisibility="Disabled"
                                    HorizontalScrollMode="Disabled"
                                    VerticalScrollBarVisibility="Auto"
                                    VerticalScrollMode="Auto">
                                <StackPanel Padding="0,12,0,0" Spacing="14">
                                    <Grid x:Name="WideMetrics" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="12">
                                            <StackPanel Spacing="3">
                                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[0].Label}" />
                                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics[0].Value}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="12">
                                            <StackPanel Spacing="3">
                                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[1].Label}" />
                                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics[1].Value}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12">
                                            <StackPanel Spacing="3">
                                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[2].Label}" />
                                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics[2].Value}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="3" Style="{StaticResource CardStyle}" Padding="12">
                                            <StackPanel Spacing="3">
                                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[3].Label}" />
                                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics[3].Value}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="12">
                                            <StackPanel Spacing="3">
                                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[4].Label}" />
                                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics[4].Value}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid x:Name="CompactMetrics" RowSpacing="8" ColumnSpacing="8" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="9">
                                            <StackPanel Spacing="2">
                                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[0].Label}" />
                                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics[0].Value}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="9">
                                            <StackPanel Spacing="2">
                                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[1].Label}" />
                                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics[1].Value}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}" Padding="9">
                                            <StackPanel Spacing="2">
                                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[2].Label}" />
                                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics[2].Value}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource CardStyle}" Padding="9">
                                            <StackPanel Spacing="2">
                                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[3].Label}" />
                                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics[3].Value}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Padding="9">
                                            <StackPanel Spacing="2">
                                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[4].Label}" />
                                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics[4].Value}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid x:Name="OverviewDetailsGrid">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="CostColumn" Width="*" />
                                            <ColumnDefinition x:Name="DetailGap" Width="14" />
                                            <ColumnDefinition x:Name="RunColumn" Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="15">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="费用构成" />
                                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="价格占比" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Top"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource PrimaryTextBrush}"
                                                        Text="{Binding Metrics[4].Value}" />
                                                </Grid>

                                                <StackPanel x:Name="WideCostRows">
                                                    <controls:CostRow Label="无缓存输入" Value="{Binding CostSlices[0].Percentage}" Detail="{Binding CostSlices[0].Detail}" BarBrush="{StaticResource PrimaryBrush}" />
                                                    <controls:CostRow Label="缓存输入" Value="{Binding CostSlices[1].Percentage}" Detail="{Binding CostSlices[1].Detail}" BarBrush="{StaticResource SuccessBrush}" />
                                                    <controls:CostRow Label="思考输出" Value="{Binding CostSlices[2].Percentage}" Detail="{Binding CostSlices[2].Detail}" BarBrush="{StaticResource WarningBrush}" />
                                                    <controls:CostRow Label="其他输出" Value="{Binding CostSlices[3].Percentage}" Detail="{Binding CostSlices[3].Detail}" BarBrush="{StaticResource PurpleBrush}" />
                                                </StackPanel>

                                                <StackPanel x:Name="CompactCostRows" Visibility="Collapsed">
                                                    <controls:CostRow Label="无缓存" LabelWidth="52" Value="{Binding CostSlices[0].Percentage}" DetailVisibility="Collapsed" BarBrush="{StaticResource PrimaryBrush}" />
                                                    <controls:CostRow Label="缓存" LabelWidth="52" Value="{Binding CostSlices[1].Percentage}" DetailVisibility="Collapsed" BarBrush="{StaticResource SuccessBrush}" />
                                                    <controls:CostRow Label="思考" LabelWidth="52" Value="{Binding CostSlices[2].Percentage}" DetailVisibility="Collapsed" BarBrush="{StaticResource WarningBrush}" />
                                                    <controls:CostRow Label="其他" LabelWidth="52" Value="{Binding CostSlices[3].Percentage}" DetailVisibility="Collapsed" BarBrush="{StaticResource PurpleBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border x:Name="RunSummaryCard" Grid.Column="2" Style="{StaticResource CardStyle}" Padding="15">
                                            <StackPanel Spacing="10">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="本次运行" />
                                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding LastReconciliationText}" />
                                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding CollectorStatusText}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding RunStatistics}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="205" ItemHeight="68" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,8,8" Style="{StaticResource InsetCardStyle}" Padding="10">
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Label}" />
                                                                    <TextBlock FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding Value}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Border
                                                    Padding="10"
                                                    Background="#1AF0B467"
                                                    BorderBrush="#66F0B467"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Text="观测覆盖" />
                                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding CoverageText}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border x:Name="ModelOverviewCard" Style="{StaticResource CardStyle}" Padding="14">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="模型概览" />
                                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="有界预览；完整表格位于“模型”页" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Padding="8,4" ColumnDefinitions="1.35*,.85*,.95*,.7*,.65*,.55*">
                                                <TextBlock Style="{StaticResource CaptionStyle}" Text="模型" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource CaptionStyle}" Text="总 tokens" />
                                                <TextBlock Grid.Column="2" Style="{StaticResource CaptionStyle}" Text="缓存输入" />
                                                <TextBlock Grid.Column="3" Style="{StaticResource CaptionStyle}" Text="输出" />
                                                <TextBlock Grid.Column="4" Style="{StaticResource CaptionStyle}" Text="费用" />
                                                <TextBlock Grid.Column="5" Style="{StaticResource CaptionStyle}" Text="占比" />
                                            </Grid>
                                            <ListView
                                                Height="152"
                                                ItemsSource="{Binding Models}"
                                                SelectionMode="None"
                                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                ScrollViewer.HorizontalScrollMode="Disabled"
                                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                ScrollViewer.VerticalScrollMode="Auto">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Padding="8,7" ColumnDefinitions="1.35*,.85*,.95*,.7*,.65*,.55*">
                                                            <TextBlock Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding Model}" />
                                                            <TextBlock Grid.Column="1" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding TotalTokens}" />
                                                            <TextBlock Grid.Column="2" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding CachedInput}" />
                                                            <TextBlock Grid.Column="3" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Output}" />
                                                            <TextBlock Grid.Column="4" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Cost}" />
                                                            <TextBlock Grid.Column="5" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Share}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                </ScrollViewer>
                            </TabViewItem>

                            <TabViewItem Header="模型" IsClosable="False">
                                <Grid Padding="12" RowDefinitions="Auto,*" RowSpacing="8">
                                    <Grid Grid.Row="0" Padding="8,4" ColumnDefinitions="1.35*,.85*,.95*,.7*,.65*,.55*">
                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="模型" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource CaptionStyle}" Text="总 tokens" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource CaptionStyle}" Text="缓存输入" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource CaptionStyle}" Text="输出" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource CaptionStyle}" Text="费用" />
                                        <TextBlock Grid.Column="5" Style="{StaticResource CaptionStyle}" Text="占比" />
                                    </Grid>
                                    <ListView Grid.Row="1" ItemsSource="{Binding Models}" SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="8,8" ColumnDefinitions="1.35*,.85*,.95*,.7*,.65*,.55*">
                                                    <TextBlock Text="{Binding Model}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding TotalTokens}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding CachedInput}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Output}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Cost}" />
                                                    <TextBlock Grid.Column="5" Text="{Binding Share}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </TabViewItem>

                            <TabViewItem Header="主体" IsClosable="False">
                                <Grid Padding="12" RowDefinitions="Auto,*" RowSpacing="8">
                                    <Grid Grid.Row="0" Padding="8,4" ColumnDefinitions=".8*,1.2*,*,*,*,.7*">
                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="类型" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource CaptionStyle}" Text="角色" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource CaptionStyle}" Text="总 tokens" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource CaptionStyle}" Text="输出" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource CaptionStyle}" Text="费用" />
                                        <TextBlock Grid.Column="5" Style="{StaticResource CaptionStyle}" Text="占比" />
                                    </Grid>
                                    <ListView Grid.Row="1" ItemsSource="{Binding Subjects}" SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="8,8" ColumnDefinitions=".8*,1.2*,*,*,*,.7*">
                                                    <TextBlock Text="{Binding ThreadType}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Role}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding TotalTokens}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Output}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Cost}" />
                                                    <TextBlock Grid.Column="5" Text="{Binding Share}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </TabViewItem>

                            <TabViewItem Header="诊断" IsClosable="False">
                                <ListView Padding="12" ItemsSource="{Binding Diagnostics}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="10" ColumnDefinitions="180,140,*">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" />
                                                <TextBlock Grid.Column="2" Style="{StaticResource CaptionStyle}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </TabViewItem>
                        </TabView>
            </Grid>
        </Grid>
    </Grid>
</Window>
