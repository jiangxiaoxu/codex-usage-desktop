<Window
    x:Class="CodexUsage.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CodexUsage.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="WindowRoot" Background="{StaticResource AppBackgroundBrush}">
        <Grid.Resources>
            <controls:SubjectTreeChildConverter x:Key="SubjectTreeChildConverter" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CommandHeaderGrid.Padding" Value="20,16" />
                        <Setter Target="CommandTitle.FontSize" Value="20" />
                        <Setter Target="WideCommandBar.Visibility" Value="Collapsed" />
                        <Setter Target="CompactCommandBar.Visibility" Value="Visible" />
                        <Setter Target="BodyRoot.Margin" Value="20,0" />
                        <Setter Target="BodyStack.Spacing" Value="16" />
                        <Setter Target="WideMetrics.Visibility" Value="Collapsed" />
                        <Setter Target="CompactMetrics.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CommandHeaderGrid.Padding" Value="24,16" />
                        <Setter Target="CommandTitle.FontSize" Value="21" />
                        <Setter Target="WideCommandBar.Visibility" Value="Collapsed" />
                        <Setter Target="CompactCommandBar.Visibility" Value="Visible" />
                        <Setter Target="BodyRoot.Margin" Value="24,0" />
                        <Setter Target="BodyStack.Spacing" Value="18" />
                        <Setter Target="WideMetrics.Visibility" Value="Visible" />
                        <Setter Target="CompactMetrics.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CommandHeaderGrid.Padding" Value="28,14" />
                        <Setter Target="CommandTitle.FontSize" Value="22" />
                        <Setter Target="WideCommandBar.Visibility" Value="Visible" />
                        <Setter Target="CompactCommandBar.Visibility" Value="Collapsed" />
                        <Setter Target="BodyRoot.Margin" Value="28,0" />
                        <Setter Target="BodyStack.Spacing" Value="20" />
                        <Setter Target="WideMetrics.Visibility" Value="Visible" />
                        <Setter Target="CompactMetrics.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="13,0"
            Background="{StaticResource TitleBarBrush}"
            ColumnDefinitions="Auto,*">
            <Border
                Width="16"
                Height="16"
                VerticalAlignment="Center"
                Background="{StaticResource PrimaryFillBrush}"
                CornerRadius="3" />
            <TextBlock
                x:Name="TitleBarText"
                Grid.Column="1"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontFamily="{StaticResource ContentControlThemeFontFamily}"
                FontSize="12"
                FontWeight="Medium"
                Foreground="{StaticResource SecondaryTextBrush}"
                Text="Codex Usage Desktop" />
        </Grid>

        <Border
            Grid.Row="1"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource TableDividerBrush}"
            BorderThickness="0,0,0,1">
            <Grid
                x:Name="CommandHeaderGrid"
                Padding="28,14"
                ColumnDefinitions="Auto,*,Auto"
                RowDefinitions="Auto,Auto"
                RowSpacing="10">
                <TextBlock
                    x:Name="CommandTitle"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource ContentControlThemeFontFamily}"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    Text="Codex 用量概览" />

                <Grid
                    Grid.Column="1"
                    MaxWidth="300"
                    Margin="24,0,16,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding HeaderStatusText}"
                    ColumnDefinitions="Auto,*"
                    ToolTipService.ToolTip="{Binding HeaderStatusText}">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{Binding HeaderStatusBrush}"
                        Glyph="{Binding HeaderStatusGlyph}" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="7,0,0,0"
                        Style="{StaticResource CommandHeaderTextStyle}"
                        Text="{Binding HeaderStatusText}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>

                <CommandBar
                    x:Name="WideCommandBar"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    IsDynamicOverflowEnabled="True"
                    Padding="0">
                    <CommandBar.Content>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource CommandHeaderTextStyle}" Text="开机自启动" />
                            <ToggleSwitch
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource ContentControlThemeFontFamily}"
                                FontSize="14"
                                IsEnabled="{Binding IsStartupAvailable}"
                                IsOn="{Binding IsStartupEnabled, Mode=TwoWay}"
                                OffContent="关"
                                OnContent="开" />
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6"
                                Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ProgressBar
                                    Width="104"
                                    Height="4"
                                    VerticalAlignment="Center"
                                    IsIndeterminate="{Binding IsUpdateDownloadIndeterminate}"
                                    Maximum="100"
                                    Value="{Binding UpdateDownloadProgressPercent}" />
                                <TextBlock
                                    Style="{StaticResource CommandHeaderTextStyle}"
                                    Text="{Binding UpdateDownloadProgressText}" />
                            </StackPanel>
                        </StackPanel>
                    </CommandBar.Content>
                    <AppBarButton Height="40" FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="14" Click="OnCheckUpdateRequested" Icon="Refresh" IsEnabled="{Binding CanCheckUpdates}" Label="检查更新" />
                    <AppBarButton Height="40" FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="14" Click="OnDownloadUpdateRequested" Icon="Download" IsEnabled="{Binding CanDownloadUpdate}" Label="{Binding DownloadUpdateLabel}" Visibility="{Binding CanDownloadUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <AppBarButton Height="40" FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="14" Click="OnRunUpdateRequested" Icon="OpenFile" IsEnabled="{Binding CanRunDownloadedUpdate}" Label="{Binding RunUpdateLabel}" ToolTipService.ToolTip="运行安装器前会复验 SHA-256; 确认后 NSIS 会结束当前应用和 collector process" Visibility="{Binding CanRunDownloadedUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </CommandBar>

                <CommandBar
                    x:Name="CompactCommandBar"
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    HorizontalAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    IsDynamicOverflowEnabled="True"
                    Padding="0"
                    Visibility="Collapsed">
                    <CommandBar.Content>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource CommandHeaderTextStyle}" Text="开机自启动" />
                            <ToggleSwitch
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource ContentControlThemeFontFamily}"
                                FontSize="14"
                                IsEnabled="{Binding IsStartupAvailable}"
                                IsOn="{Binding IsStartupEnabled, Mode=TwoWay}"
                                OffContent="关"
                                OnContent="开" />
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6"
                                Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ProgressBar
                                    Width="104"
                                    Height="4"
                                    VerticalAlignment="Center"
                                    IsIndeterminate="{Binding IsUpdateDownloadIndeterminate}"
                                    Maximum="100"
                                    Value="{Binding UpdateDownloadProgressPercent}" />
                                <TextBlock
                                    Style="{StaticResource CommandHeaderTextStyle}"
                                    Text="{Binding UpdateDownloadProgressText}" />
                            </StackPanel>
                        </StackPanel>
                    </CommandBar.Content>
                    <AppBarButton Height="40" FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="14" Click="OnCheckUpdateRequested" Icon="Refresh" IsEnabled="{Binding CanCheckUpdates}" Label="检查更新" />
                    <AppBarButton Height="40" FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="14" Click="OnDownloadUpdateRequested" Icon="Download" IsEnabled="{Binding CanDownloadUpdate}" Label="{Binding DownloadUpdateLabel}" Visibility="{Binding CanDownloadUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <AppBarButton Height="40" FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="14" Click="OnRunUpdateRequested" Icon="OpenFile" IsEnabled="{Binding CanRunDownloadedUpdate}" Label="{Binding RunUpdateLabel}" ToolTipService.ToolTip="运行安装器前会复验 SHA-256; 确认后 NSIS 会结束当前应用和 collector process" Visibility="{Binding CanRunDownloadedUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </CommandBar>
            </Grid>
        </Border>

        <ScrollViewer
            x:Name="BodyRoot"
            Grid.Row="2"
            Margin="28,0"
            AutomationProperties.Name="内容区域"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            IsTabStop="True"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto"
            >
            <StackPanel x:Name="BodyStack" Padding="0,8,16,28" Spacing="20">
                <Border
                    BorderBrush="{StaticResource TableDividerBrush}"
                    BorderThickness="0,0,0,1">
                    <controls:AuditFilterContent x:Name="AuditFilters" />
                </Border>

                <Border
                    x:Name="WideMetrics"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource TableDividerBrush}"
                    BorderThickness="0,1">
                    <Grid ColumnDefinitions="*,1,*,1,*,1,*,1,*">
                        <StackPanel Grid.Column="0" Margin="14,10" Spacing="2">
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[0].Label}" />
                            <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics[0].Value}" />
                        </StackPanel>
                        <Rectangle Grid.Column="1" Margin="0,10" Fill="{StaticResource TableDividerBrush}" />
                        <StackPanel Grid.Column="2" Margin="14,10" Spacing="2">
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[1].Label}" />
                            <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics[1].Value}" />
                        </StackPanel>
                        <Rectangle Grid.Column="3" Margin="0,10" Fill="{StaticResource TableDividerBrush}" />
                        <StackPanel Grid.Column="4" Margin="14,10" Spacing="2">
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[2].Label}" />
                            <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics[2].Value}" />
                        </StackPanel>
                        <Rectangle Grid.Column="5" Margin="0,10" Fill="{StaticResource TableDividerBrush}" />
                        <StackPanel Grid.Column="6" Margin="14,10" Spacing="2">
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[3].Label}" />
                            <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics[3].Value}" />
                        </StackPanel>
                        <Rectangle Grid.Column="7" Margin="0,10" Fill="{StaticResource TableDividerBrush}" />
                        <StackPanel Grid.Column="8" Margin="14,10" Spacing="2">
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[4].Label}" />
                            <TextBlock FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding Metrics[4].Value}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    x:Name="CompactMetrics"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource TableDividerBrush}"
                    BorderThickness="0,1"
                    Visibility="Collapsed">
                    <Grid RowDefinitions="Auto,1,Auto,1,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*,1,*">
                            <StackPanel Grid.Column="0" Margin="14,10" Spacing="2">
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[0].Label}" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics[0].Value}" />
                            </StackPanel>
                            <Rectangle Grid.Column="1" Margin="0,10" Fill="{StaticResource TableDividerBrush}" />
                            <StackPanel Grid.Column="2" Margin="14,10" Spacing="2">
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[1].Label}" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics[1].Value}" />
                            </StackPanel>
                        </Grid>
                        <Rectangle Grid.Row="1" Fill="{StaticResource TableDividerBrush}" />
                        <Grid Grid.Row="2" ColumnDefinitions="*,1,*">
                            <StackPanel Grid.Column="0" Margin="14,10" Spacing="2">
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[2].Label}" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics[2].Value}" />
                            </StackPanel>
                            <Rectangle Grid.Column="1" Margin="0,10" Fill="{StaticResource TableDividerBrush}" />
                            <StackPanel Grid.Column="2" Margin="14,10" Spacing="2">
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[3].Label}" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics[3].Value}" />
                            </StackPanel>
                        </Grid>
                        <Rectangle Grid.Row="3" Fill="{StaticResource TableDividerBrush}" />
                        <StackPanel Grid.Row="4" Margin="14,10" Spacing="2">
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Metrics[4].Label}" />
                            <TextBlock FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding Metrics[4].Value}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    Padding="14,10"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource TableDividerBrush}"
                    BorderThickness="0,1">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="费用构成" />
                        <controls:CostCompositionBar
                            DetailsAlwaysVisible="True"
                            VisualHeight="10"
                            Items="{Binding CostSlices}" />
                    </StackPanel>
                </Border>

                <controls:ChipWrapPanel
                    Margin="0,0"
                    HorizontalSpacing="14"
                    VerticalSpacing="6">
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="费用构成（唯一图例）" />
                    <Grid ColumnDefinitions="10,Auto" ColumnSpacing="7">
                        <Rectangle Width="10" Height="10" VerticalAlignment="Center" Fill="{StaticResource CostUncachedBrush}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource CaptionStyle}" Text="{Binding CostSlices[0].Label}" />
                    </Grid>
                    <Grid ColumnDefinitions="10,Auto" ColumnSpacing="7">
                        <Rectangle Width="10" Height="10" VerticalAlignment="Center" Fill="{StaticResource CostCachedBrush}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource CaptionStyle}" Text="{Binding CostSlices[1].Label}" />
                    </Grid>
                    <Grid ColumnDefinitions="10,Auto" ColumnSpacing="7">
                        <Rectangle Width="10" Height="10" VerticalAlignment="Center" Fill="{StaticResource CostReasoningBrush}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource CaptionStyle}" Text="{Binding CostSlices[2].Label}" />
                    </Grid>
                    <Grid ColumnDefinitions="10,Auto" ColumnSpacing="7">
                        <Rectangle Width="10" Height="10" VerticalAlignment="Center" Fill="{StaticResource CostOtherBrush}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource CaptionStyle}" Text="{Binding CostSlices[3].Label}" />
                    </Grid>
                </controls:ChipWrapPanel>

                <Grid x:Name="DashboardPanelGrid" ColumnSpacing="12" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="DashboardFirstColumn" Width="*" />
                        <ColumnDefinition x:Name="DashboardSecondColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="ModelPanel"
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="0,6"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel>
                            <TextBlock Margin="12,0,12,4" Style="{StaticResource SectionTitleStyle}" Text="按模型" />
                            <ItemsControl HorizontalContentAlignment="Stretch" ItemsSource="{Binding Models}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,6" BorderBrush="{StaticResource TableDividerBrush}" BorderThickness="0,1,0,0">
                                            <StackPanel Spacing="2">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                                    <TextBlock
                                                        AutomationProperties.Name="{Binding Model}"
                                                        FontSize="15"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource PrimaryTextBrush}"
                                                        Text="{Binding Model}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTipService.ToolTip="{Binding Model}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontSize="15"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource PrimaryTextBrush}"
                                                        Text="{Binding Cost}" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Foreground="{StaticResource SecondaryTextBrush}"
                                                        Text="{Binding Share}" />
                                                </Grid>
                                                <controls:CostCompositionBar
                                                    VisualHeight="10"
                                                    Items="{Binding CostSlices}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="SubjectPanel"
                        Grid.Row="1"
                        Grid.Column="0"
                        Padding="0,6"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel>
                            <TextBlock Margin="12,0,12,4" Style="{StaticResource SectionTitleStyle}" Text="按执行主体" />
                            <ItemsControl HorizontalContentAlignment="Stretch" ItemsSource="{Binding Subjects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,6" BorderBrush="{StaticResource TableDividerBrush}" BorderThickness="0,1,0,0">
                                            <Grid>
                                                <Border
                                                    Width="1"
                                                    Margin="10,1,0,1"
                                                    HorizontalAlignment="Left"
                                                    Background="{StaticResource TableDividerBrush}"
                                                    Visibility="{Binding Converter={StaticResource SubjectTreeChildConverter}, ConverterParameter=guide}" />
                                                <StackPanel
                                                    Margin="{Binding Converter={StaticResource SubjectTreeChildConverter}}"
                                                    Spacing="2">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                                    <TextBlock
                                                        AutomationProperties.Name="{Binding DisplayName}"
                                                        FontSize="15"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource PrimaryTextBrush}"
                                                        Text="{Binding DisplayName}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTipService.ToolTip="{Binding DisplayName}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontSize="15"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource PrimaryTextBrush}"
                                                        Text="{Binding Cost}" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Foreground="{StaticResource SecondaryTextBrush}"
                                                        Text="{Binding Share}" />
                                                </Grid>
                                                <controls:CostCompositionBar
                                                    VisualHeight="10"
                                                    Items="{Binding CostSlices}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource TableDividerBrush}"
                    BorderThickness="0,1">
                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="12,4"
                        AutomationProperties.Name="诊断详情"
                        Header="诊断"
                        IsExpanded="False">
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Auto"
                            HorizontalContentAlignment="Stretch"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled">
                            <ListView
                                MinWidth="620"
                                Padding="0,8,0,0"
                                HorizontalContentAlignment="Stretch"
                                ItemsSource="{Binding Diagnostics}"
                                SelectionMode="None"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.HorizontalScrollMode="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollMode="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="42" Padding="10,7" ColumnDefinitions="220,160,*" ColumnSpacing="32">
                                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Label}" />
                                            <TextBlock Grid.Column="1" FontSize="14" Text="{Binding Value}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource CaptionStyle}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ScrollViewer>
                    </Expander>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
