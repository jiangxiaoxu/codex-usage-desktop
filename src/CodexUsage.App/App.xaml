<Application
    x:Class="CodexUsage.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#101214" />
            <SolidColorBrush x:Key="TitleBarBrush" Color="#0B0E13" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#161B24" />
            <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#171C24" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#293445" />
            <SolidColorBrush x:Key="ControlBorderBrush" Color="#344052" />
            <SolidColorBrush x:Key="PrimaryBrush" Color="#4F8EF7" />
            <SolidColorBrush x:Key="PrimaryFillBrush" Color="#2D6CDF" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#72D8B8" />
            <SolidColorBrush x:Key="WarningBrush" Color="#F0B467" />
            <SolidColorBrush x:Key="DangerBrush" Color="#F4777C" />
            <SolidColorBrush x:Key="PurpleBrush" Color="#8D7DE0" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#EDF0F5" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#AAB4C3" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#8D9AAE" />
            <SolidColorBrush x:Key="ProgressTrackBrush" Color="#344052" />

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>

            <Style x:Key="InsetCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
                <Setter Property="Background" Value="{StaticResource ElevatedSurfaceBrush}" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="CaptionStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="FontSize" Value="11" />
            </Style>

            <Style x:Key="MetricValueStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style TargetType="ProgressBar">
                <Setter Property="Height" Value="8" />
                <Setter Property="Background" Value="{StaticResource ProgressTrackBrush}" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="6" />
            </Style>

            <Style TargetType="ToggleButton">
                <Setter Property="CornerRadius" Value="6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
