<UserControl
    x:Class="CodexUsage.App.Controls.AuditFilterContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CodexUsage.App.Controls">

    <Grid x:Name="FilterRoot">
        <Grid.Resources>
            <Style x:Key="FilterLabelStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="Medium" />
            </Style>
            <Style x:Key="FilterSelectionButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Background" Value="{StaticResource InputSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="3" />
            </Style>
        </Grid.Resources>

        <Grid
            x:Name="WideLayout"
            Padding="0,8"
            ColumnSpacing="10"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="128" />
                <ColumnDefinition Width="142" />
                <ColumnDefinition MinWidth="220" Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Style="{StaticResource FilterLabelStyle}" Text="时间范围" />
            <Border
                Grid.Column="1"
                MinHeight="36"
                Padding="10,6"
                Background="{StaticResource InputSurfaceBrush}"
                BorderBrush="{StaticResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="3">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    Text="{Binding RangeLabel}"
                    TextTrimming="CharacterEllipsis" />
            </Border>
            <controls:PiecewiseTimeSlider
                x:Name="WideTimeSlider"
                Grid.Column="2"
                MinHeight="36"
                AutomationProperties.HelpText="{Binding RangeLabel}"
                AutomationProperties.Name="连续时间范围"
                Value="{Binding RangeScalePosition, Mode=TwoWay}" />
            <Button Grid.Column="3" Click="OnOpenCustomDateRange" ToolTipService.ToolTip="自定义日期范围">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Calendar" />
                    <TextBlock FontSize="13" Text="日期" />
                </StackPanel>
            </Button>

            <Button
                x:Name="WideModelSelectionButton"
                Grid.Column="4"
                AutomationProperties.Name="模型筛选"
                Style="{StaticResource FilterSelectionButtonStyle}">
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <Border
                            MinWidth="336"
                            MaxWidth="420"
                            Padding="12"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource TableDividerBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Style="{StaticResource FilterLabelStyle}" Text="模型" />
                                    <Button
                                        Grid.Column="1"
                                        AutomationProperties.Name="全选模型"
                                        Click="OnSelectAllModels"
                                        Content="全选" />
                                </Grid>
                                <ScrollViewer Grid.Row="1" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ModelOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:ChipWrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton
                                                    MinHeight="36"
                                                    Padding="10,6"
                                                    AutomationProperties.Name="{Binding Label}"
                                                    Click="OnModelOptionInvoked"
                                                    HorizontalContentAlignment="Left"
                                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                    Style="{StaticResource FilterToggleButtonStyle}"
                                                    ToolTipService.ToolTip="{Binding Label}">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <FontIcon FontSize="11" Glyph="{Binding SelectionGlyph}" />
                                                        <TextBlock FontSize="13" Text="{Binding Label}" />
                                                    </StackPanel>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Flyout>
                </Button.Flyout>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBlock x:Name="WideModelSelectionText" VerticalAlignment="Center" Text="模型" TextTrimming="CharacterEllipsis" />
                    <FontIcon Grid.Column="1" FontSize="12" Glyph="&#xE70D;" />
                </Grid>
            </Button>

            <Button
                x:Name="WideAgentSelectionButton"
                Grid.Column="5"
                AutomationProperties.Name="执行主体筛选"
                Style="{StaticResource FilterSelectionButtonStyle}">
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <Border
                            MinWidth="336"
                            MaxWidth="420"
                            Padding="12"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource TableDividerBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Style="{StaticResource FilterLabelStyle}" Text="执行主体" />
                                    <Button
                                        Grid.Column="1"
                                        AutomationProperties.Name="全选执行主体"
                                        Click="OnSelectAllAgents"
                                        Content="全选" />
                                </Grid>
                                <ScrollViewer Grid.Row="1" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding AgentOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:ChipWrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton
                                                    MinHeight="36"
                                                    Padding="10,6"
                                                    AutomationProperties.Name="{Binding Label}"
                                                    Click="OnAgentOptionInvoked"
                                                    HorizontalContentAlignment="Left"
                                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                    Style="{StaticResource FilterToggleButtonStyle}"
                                                    ToolTipService.ToolTip="{Binding Label}">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <FontIcon FontSize="11" Glyph="{Binding SelectionGlyph}" />
                                                        <TextBlock FontSize="13" Text="{Binding Label}" />
                                                    </StackPanel>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Flyout>
                </Button.Flyout>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBlock x:Name="WideAgentSelectionText" VerticalAlignment="Center" Text="执行主体" TextTrimming="CharacterEllipsis" />
                    <FontIcon Grid.Column="1" FontSize="12" Glyph="&#xE70D;" />
                </Grid>
            </Button>

            <Grid Grid.Column="6" RowDefinitions="Auto,Auto">
                <AutoSuggestBox
                    x:Name="WideMainThreadSuggestions"
                    MinHeight="36"
                    AutomationProperties.HelpText="{Binding MainThreadInputValidationMessage}"
                    AutomationProperties.Name="主线程 ID"
                    Background="{StaticResource InputSurfaceBrush}"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    CornerRadius="3"
                    DisplayMemberPath="DisplayLabel"
                    GotFocus="OnMainThreadSuggestionsGotFocus"
                    ItemsSource="{Binding MainThreadOptions}"
                    PlaceholderText="主线程 ID"
                    SuggestionChosen="OnMainThreadSuggestionChosen"
                    Text="{Binding MainThreadInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextMemberPath="DisplayLabel"
                    ToolTipService.ToolTip="选择或输入完整主线程 ID"
                    UpdateTextOnSelect="True" />
                <Border
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    IsHitTestVisible="False"
                    Visibility="{Binding HasMainThreadInputError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    AutomationProperties.LiveSetting="Assertive"
                    Foreground="{StaticResource DangerBrush}"
                    Text="{Binding MainThreadInputValidationMessage}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasMainThreadInputError, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
            <Button
                Grid.Column="7"
                AutomationProperties.Name="清空主线程筛选"
                Click="OnClearMainThreadFilter"
                ToolTipService.ToolTip="清空主线程筛选">
                <SymbolIcon Symbol="Clear" />
            </Button>
            <Button
                Grid.Column="8"
                AutomationProperties.Name="恢复全部筛选"
                Click="OnResetFilters"
                ToolTipService.ToolTip="恢复全部筛选">
                <SymbolIcon Symbol="Refresh" />
            </Button>
        </Grid>

        <Grid
            x:Name="CompactLayout"
            Padding="0,8"
            ColumnSpacing="10"
            RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="88" />
                <ColumnDefinition MinWidth="140" Width="*" />
                <ColumnDefinition Width="122" />
                <ColumnDefinition Width="136" />
                <ColumnDefinition Width="104" />
            </Grid.ColumnDefinitions>

            <TextBlock Style="{StaticResource FilterLabelStyle}" Text="时间范围" />
            <Border
                Grid.Column="1"
                MinHeight="36"
                Padding="10,6"
                Background="{StaticResource InputSurfaceBrush}"
                BorderBrush="{StaticResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="3">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    Text="{Binding RangeLabel}"
                    TextTrimming="CharacterEllipsis" />
            </Border>
            <controls:PiecewiseTimeSlider
                x:Name="CompactTimeSlider"
                Grid.Column="2"
                MinHeight="36"
                AutomationProperties.HelpText="{Binding RangeLabel}"
                AutomationProperties.Name="连续时间范围"
                Value="{Binding RangeScalePosition, Mode=TwoWay}" />
            <Button
                x:Name="CompactModelSelectionButton"
                Grid.Column="3"
                AutomationProperties.Name="模型筛选"
                Style="{StaticResource FilterSelectionButtonStyle}">
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <Border
                            MinWidth="336"
                            MaxWidth="420"
                            Padding="12"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource TableDividerBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Style="{StaticResource FilterLabelStyle}" Text="模型" />
                                    <Button
                                        Grid.Column="1"
                                        AutomationProperties.Name="全选模型"
                                        Click="OnSelectAllModels"
                                        Content="全选" />
                                </Grid>
                                <ScrollViewer Grid.Row="1" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ModelOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:ChipWrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton
                                                    MinHeight="36"
                                                    Padding="10,6"
                                                    AutomationProperties.Name="{Binding Label}"
                                                    Click="OnModelOptionInvoked"
                                                    HorizontalContentAlignment="Left"
                                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                    Style="{StaticResource FilterToggleButtonStyle}"
                                                    ToolTipService.ToolTip="{Binding Label}">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <FontIcon FontSize="11" Glyph="{Binding SelectionGlyph}" />
                                                        <TextBlock FontSize="13" Text="{Binding Label}" />
                                                    </StackPanel>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Flyout>
                </Button.Flyout>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBlock x:Name="CompactModelSelectionText" VerticalAlignment="Center" Text="模型" TextTrimming="CharacterEllipsis" />
                    <FontIcon Grid.Column="1" FontSize="12" Glyph="&#xE70D;" />
                </Grid>
            </Button>
            <Button
                x:Name="CompactAgentSelectionButton"
                Grid.Column="4"
                AutomationProperties.Name="执行主体筛选"
                Style="{StaticResource FilterSelectionButtonStyle}">
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <Border
                            MinWidth="336"
                            MaxWidth="420"
                            Padding="12"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource TableDividerBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Style="{StaticResource FilterLabelStyle}" Text="执行主体" />
                                    <Button
                                        Grid.Column="1"
                                        AutomationProperties.Name="全选执行主体"
                                        Click="OnSelectAllAgents"
                                        Content="全选" />
                                </Grid>
                                <ScrollViewer Grid.Row="1" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding AgentOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:ChipWrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton
                                                    MinHeight="36"
                                                    Padding="10,6"
                                                    AutomationProperties.Name="{Binding Label}"
                                                    Click="OnAgentOptionInvoked"
                                                    HorizontalContentAlignment="Left"
                                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                    Style="{StaticResource FilterToggleButtonStyle}"
                                                    ToolTipService.ToolTip="{Binding Label}">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <FontIcon FontSize="11" Glyph="{Binding SelectionGlyph}" />
                                                        <TextBlock FontSize="13" Text="{Binding Label}" />
                                                    </StackPanel>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Flyout>
                </Button.Flyout>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBlock x:Name="CompactAgentSelectionText" VerticalAlignment="Center" Text="执行主体" TextTrimming="CharacterEllipsis" />
                    <FontIcon Grid.Column="1" FontSize="12" Glyph="&#xE70D;" />
                </Grid>
            </Button>
            <Button Grid.Column="5" Click="OnOpenCustomDateRange" ToolTipService.ToolTip="自定义日期范围">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Calendar" />
                    <TextBlock FontSize="13" Text="日期" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Row="1" Style="{StaticResource FilterLabelStyle}" Text="主线程" />
            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3">
                <AutoSuggestBox
                    x:Name="CompactMainThreadSuggestions"
                    MinHeight="36"
                    AutomationProperties.HelpText="{Binding MainThreadInputValidationMessage}"
                    AutomationProperties.Name="主线程 ID"
                    Background="{StaticResource InputSurfaceBrush}"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    CornerRadius="3"
                    DisplayMemberPath="DisplayLabel"
                    GotFocus="OnMainThreadSuggestionsGotFocus"
                    ItemsSource="{Binding MainThreadOptions}"
                    PlaceholderText="选择或输入完整主线程 ID"
                    SuggestionChosen="OnMainThreadSuggestionChosen"
                    Text="{Binding MainThreadInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextMemberPath="DisplayLabel"
                    UpdateTextOnSelect="True" />
                <Border
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    IsHitTestVisible="False"
                    Visibility="{Binding HasMainThreadInputError, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
            <Button
                Grid.Row="1"
                Grid.Column="4"
                AutomationProperties.Name="清空主线程筛选"
                Click="OnClearMainThreadFilter">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Clear" />
                    <TextBlock Text="清空" />
                </StackPanel>
            </Button>
            <Button
                Grid.Row="1"
                Grid.Column="5"
                AutomationProperties.Name="恢复全部筛选"
                Click="OnResetFilters">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Refresh" />
                    <TextBlock Text="重置" />
                </StackPanel>
            </Button>
            <TextBlock
                Grid.Row="2"
                Grid.Column="1"
                Grid.ColumnSpan="5"
                Margin="0,4,0,0"
                AutomationProperties.LiveSetting="Assertive"
                Foreground="{StaticResource DangerBrush}"
                Text="{Binding MainThreadInputValidationMessage}"
                TextWrapping="Wrap"
                Visibility="{Binding HasMainThreadInputError, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </Grid>
</UserControl>
