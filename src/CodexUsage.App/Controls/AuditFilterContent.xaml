<UserControl
    x:Class="CodexUsage.App.Controls.AuditFilterContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="14">
        <Expander Header="时间范围 (SGT)" IsExpanded="True">
            <StackPanel Padding="0,10,0,2" Spacing="8">
                <TextBlock Style="{StaticResource CaptionStyle}" Text="连续范围" />
                <TextBlock
                    FontSize="12"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    Text="{Binding RangeLabel}" />
                <Slider
                    Minimum="0.5"
                    Maximum="336"
                    StepFrequency="0.5"
                    Value="{Binding RangeHours, Mode=TwoWay}" />
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*,Auto">
                    <TextBlock Grid.Column="0" Style="{StaticResource CaptionStyle}" Text="30分" />
                    <TextBlock Grid.Column="2" Style="{StaticResource CaptionStyle}" Text="12h" />
                    <TextBlock Grid.Column="4" Style="{StaticResource CaptionStyle}" Text="1天" />
                    <TextBlock Grid.Column="6" Style="{StaticResource CaptionStyle}" Text="7天" />
                    <TextBlock Grid.Column="8" Style="{StaticResource CaptionStyle}" Text="14天" />
                </Grid>
            </StackPanel>
        </Expander>

        <Expander Header="模型" IsExpanded="True">
            <StackPanel Padding="0,10,0,2" Spacing="8">
                <TextBlock Style="{StaticResource CaptionStyle}" Text="默认全选" />
                <ItemsControl ItemsSource="{Binding ModelOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton
                                Margin="0,0,6,6"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                Content="{Binding Label}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Expander>

        <Expander Header="执行主体" IsExpanded="True">
            <StackPanel Padding="0,10,0,2" Spacing="8">
                <TextBlock Style="{StaticResource CaptionStyle}" Text="模型与执行主体独立选择" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding AgentOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton
                                Margin="0,0,6,6"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                Content="{Binding Label}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Expander>

        <StackPanel Spacing="6">
            <TextBlock Style="{StaticResource CaptionStyle}" Text="线程检索" />
            <TextBox
                PlaceholderText="agent path / nickname / rollout ID"
                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <Button Click="OnResetFilters" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <SymbolIcon Symbol="Refresh" />
                <TextBlock Text="恢复全部筛选" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
