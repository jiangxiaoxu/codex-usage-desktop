<UserControl
    x:Class="CodexUsage.App.Controls.CostRow"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,0,0,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <TextBlock
            Width="{x:Bind LabelWidth, Mode=OneWay}"
            VerticalAlignment="Center"
            FontSize="11"
            Foreground="{StaticResource PrimaryTextBrush}"
            Text="{x:Bind Label, Mode=OneWay}" />
        <ProgressBar
            Grid.Column="1"
            Maximum="100"
            Foreground="{x:Bind BarBrush, Mode=OneWay}"
            Value="{x:Bind Value, Mode=OneWay}" />
        <TextBlock
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            FontSize="11"
            FontWeight="SemiBold"
            Foreground="{StaticResource PrimaryTextBrush}"
            Text="{x:Bind Detail, Mode=OneWay}"
            Visibility="{x:Bind DetailVisibility, Mode=OneWay}" />
    </Grid>
</UserControl>
