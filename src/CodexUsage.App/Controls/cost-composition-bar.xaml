<UserControl
    x:Class="CodexUsage.App.Controls.CostCompositionBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CodexUsage.App.Controls">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TrackHost" Grid.Row="0">
            <Border
                x:Name="NeutralTrack"
                VerticalAlignment="Center"
                Background="{StaticResource ProgressTrackBrush}" />
            <Grid x:Name="SegmentsHost" IsHitTestVisible="False" />
            <Border
                x:Name="InteractionSurface"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                IsTabStop="False"
                UseSystemFocusVisuals="True" />
        </Grid>

        <controls:ChipWrapPanel
            x:Name="LegendHost"
            Grid.Row="1"
            Margin="0,0,0,1"
            HorizontalSpacing="28"
            LineDistribution="EqualCells"
            VerticalSpacing="8" />
    </Grid>
</UserControl>
